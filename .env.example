# ── Database ─────────────────────────────────────────────
# Lokal: postgresql://pos:pos@localhost:5432/catalog_sample?schema=public
# Vercel + Neon: kedua variabel ini otomatis diisi oleh integrasi Neon.
# Database lain (Supabase dll): DATABASE_URL = URL pooled, DATABASE_URL_UNPOOLED = URL langsung (non-pooled)
DATABASE_URL="postgresql://pos:pos@localhost:5432/catalog_sample?schema=public"
DATABASE_URL_UNPOOLED="postgresql://pos:pos@localhost:5432/catalog_sample?schema=public"

# ── Auth ─────────────────────────────────────────────────
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Akun admin pertama (npm run db:seed). Ganti password setelah login.
ADMIN_EMAIL="admin@katalog.local"
ADMIN_PASSWORD="ganti-password-ini"
ADMIN_NAME="Admin"

# ── Storage ──────────────────────────────────────────────
# Wajib di Vercel (Storage → Blob). Kosong = simpan di ./uplo ads (hanya untuk lokal).
BLOB_READ_WRITE_TOKEN=""

# ── Site ─────────────────────────────────────────────────
PUBLIC_SITE_URL="https://nama-proyek.vercel.app"
